/target
# 多平台 Release 构建产物（scripts/build-release.sh 输出，由 CI 上传为 Release 附件）
/dist
# 字体中间产物（完整版 8MB，子集化后由脚本删除；见 scripts/make_font_subset.py）
gui/assets/*.full.otf
gui/assets/unicodes.txt

# req-guard 门禁本机运行态（不入库）
.gates/.bypass
.gates/audit/*.log

# AI 工具 hook 配置：req-guard install 从 templates/ 派生，可再生，入库即多一份真相源
/.claude/settings.json
/.codebuddy/settings.json
/.codex/hooks.json
/.cursor/hooks.json

# 草稿区（AI 拟改清单内容的暂存处，工作态；apply 消费后即删除）
/.gates/drafts

# Python 字节码缓存：scripts/ 下的注入器与 verify_gate.py 跑起来会生成，
# 入库即多一份可再生物（且每次 mtime 不同会让 git status 常带噪声）。
__pycache__/
